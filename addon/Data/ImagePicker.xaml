<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="StudioTool.ImagePicker"
  x:Name="PickerRoot">

  <UserControl.Resources>
    <Style x:Key="Picker.Thumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="ThumbBody" Background="#FFB8C0CC" CornerRadius="4"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ThumbBody" Property="Background" Value="#FF8793A3"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ThumbBody" Property="Background" Value="#FF64748B"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Picker.PageButton" TargetType="RepeatButton">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ControlTemplate x:Key="Picker.ScrollBar.Horizontal" TargetType="ScrollBar">
      <Border Background="#FFF1F3F6" Height="12">
        <Track x:Name="PART_Track" Orientation="Horizontal">
          <Track.DecreaseRepeatButton>
            <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Picker.PageButton}"/>
          </Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton>
            <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Picker.PageButton}"/>
          </Track.IncreaseRepeatButton>
          <Track.Thumb>
            <Thumb Style="{StaticResource Picker.Thumb}" Margin="0,2"/>
          </Track.Thumb>
        </Track>
      </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="Picker.ScrollBar.Vertical" TargetType="ScrollBar">
      <Border Background="#FFF1F3F6" Width="12">
        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton>
            <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Picker.PageButton}"/>
          </Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton>
            <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Picker.PageButton}"/>
          </Track.IncreaseRepeatButton>
          <Track.Thumb>
            <Thumb Style="{StaticResource Picker.Thumb}" Margin="2,0"/>
          </Track.Thumb>
        </Track>
      </Border>
    </ControlTemplate>
    <Style x:Key="Picker.ScrollBar" TargetType="ScrollBar">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Template" Value="{StaticResource Picker.ScrollBar.Horizontal}"/>
        </Trigger>
        <Trigger Property="Orientation" Value="Vertical">
          <Setter Property="Template" Value="{StaticResource Picker.ScrollBar.Vertical}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <ControlTemplate x:Key="Picker.ScrollViewer" TargetType="ScrollViewer">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ScrollContentPresenter Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
            CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
          <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal"
            Style="{StaticResource Picker.ScrollBar}"
            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
            Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
            ViewportSize="{TemplateBinding ViewportWidth}" Minimum="0"
            Maximum="{TemplateBinding ScrollableWidth}"/>
          <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
            Style="{StaticResource Picker.ScrollBar}"
            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
            Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
            ViewportSize="{TemplateBinding ViewportHeight}" Minimum="0"
            Maximum="{TemplateBinding ScrollableHeight}"/>
        </Grid>
      </Border>
    </ControlTemplate>
    <Style TargetType="Button">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Background" Value="#FFFFFFFF"/>
      <Setter Property="Foreground" Value="#FF1F2937"/>
      <Setter Property="BorderBrush" Value="#FFD4DAE3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBody" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
              Padding="{TemplateBinding Padding}" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBody" Property="Background" Value="#FFE8EDF5"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBody" Property="Background" Value="#FFDCE5F2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBody" Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFFFF"/>
      <Setter Property="Foreground" Value="#FF1F2937"/>
      <Setter Property="BorderBrush" Value="#FFD4DAE3"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FF1F2937"/>
    </Style>
    <Style TargetType="ScrollViewer">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Background" Value="#FFF7F8FA"/>
      <Setter Property="PanningMode" Value="VerticalFirst"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template" Value="{StaticResource Picker.ScrollViewer}"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <ContentPresenter x:Name="DefaultHost"/>

    <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=DefaultHost}"
      Placement="Left" StaysOpen="True" AllowsTransparency="True">
      <Border Width="1040" Height="650" Margin="0,0,6,0" Padding="12"
        Background="#FFFFFFFF" BorderBrush="#FFD4DAE3" BorderThickness="1" CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ImageSource" FontSize="18" FontWeight="Bold"
              Foreground="#FF111827" VerticalAlignment="Center"/>
            <TextBlock x:Name="FolderPath" Grid.Column="1" Margin="18,0"
              Foreground="#FF64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="CloseButton" Grid.Column="2" Width="32" Height="28" Content="×"/>
          </Grid>

          <Grid Grid.Row="1" Margin="0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="430"/>
              <ColumnDefinition Width="1"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFF7F8FA" BorderBrush="#FFE1E5EB"
              BorderThickness="1" CornerRadius="6" Padding="8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="30"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="文件夹（按字母排列）" Foreground="#FF334155"
                  FontWeight="Bold" VerticalAlignment="Center"/>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Background="#FFF7F8FA">
                  <StackPanel x:Name="FolderColumns" Orientation="Vertical"/>
                </ScrollViewer>
              </Grid>
            </Border>

            <Border Grid.Column="1" Background="#FFD8DEE8"/>

            <Border Grid.Column="2" Background="#FFF7F8FA" BorderBrush="#FFE1E5EB"
              BorderThickness="1" CornerRadius="6" Padding="8" Margin="10,0,0,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel x:Name="LetterPanel" Grid.Row="0" Margin="0,0,0,8"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Background="#FFF7F8FA">
                  <WrapPanel x:Name="FilePanel"/>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="当前文件夹及所有子文件夹中的图片"
              Foreground="#FF64748B" VerticalAlignment="Center"/>
            <TextBlock x:Name="FileCount" Grid.Column="1" Foreground="#FF1F2937"
              FontWeight="Bold" VerticalAlignment="Center"/>
          </Grid>
        </Grid>
      </Border>
    </Popup>
  </Grid>
</UserControl>
